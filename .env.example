# ── VivaSense STANDALONE Supabase project ───────────────────────────────────
# Use the dedicated VivaSense Supabase project — NOT the shared fia-institute-portal
# project. Point these at the new project (Project Settings → API):
#   VITE_SUPABASE_URL              = Project URL
#   VITE_SUPABASE_PUBLISHABLE_KEY  = anon / publishable key (safe for the browser)
VITE_SUPABASE_URL=https://<vivasense-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<vivasense-anon-key>

# VivaSense compute backend (FastAPI + R). Has no Supabase dependency; unchanged.
# VITE_API_URL=https://vivasense-backend-r-production.up.railway.app

# ── Edge function secret (set in the Supabase project, NOT here) ─────────────
# The vivasense-interpret function requires ANTHROPIC_API_KEY, configured via:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# It is a server-side secret and must never be exposed to the frontend.
